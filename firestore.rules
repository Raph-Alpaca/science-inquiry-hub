rules_version = '2';

// 산출물 책장 보안 규칙
//
//  누가 무엇을 하는가
//   - 학생(비로그인): 승인된 책만 읽고, 책장 코드가 맞을 때만 제출할 수 있다.
//   - 선생님(승인된 구글 계정): 자기 책장을 만들고, 자기 책장의 책만 승인·수정한다.
//   - 관리자: 선생님 승인 명단을 관리하고, 필요하면 책장·책을 정리한다.
//
//  관리자와 승인 명단은 이메일을 소문자로 바꾼 값을 문서 이름으로 쓴다.
//   admins/{이메일}   ← Firebase 콘솔에서 직접 만든다 (규칙으로는 못 바꾼다)
//   allowed/{이메일}  ← 관리자가 선생님 화면에서 추가·삭제한다
//   requests/{이메일} ← 로그인한 선생님이 직접 내는 사용 신청. 승인·거절하면 지운다(연락처를 남기지 않는다)
//
//  모둠원 학번(private)은 그 책장을 만든 선생님만 읽는다. 관리자도 읽지 않는다.
//  학생 이름은 어디에도 받지 않는다(개인정보). 활동지는 학번만 쓴다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email is string;
    }
    function em() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(em()));
    }
    function isApproved() {
      return signedIn() && (exists(/databases/$(database)/documents/allowed/$(em())) || isAdmin());
    }
    function shelf(shelfId) {
      return get(/databases/$(database)/documents/shelves/$(shelfId)).data;
    }
    function isOwner(shelfId) {
      return request.auth != null && request.auth.uid == shelf(shelfId).teacherUid;
    }
    function codeMatches(shelfId) {
      return request.resource.data.code is string && request.resource.data.code == shelf(shelfId).code;
    }
    function str(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }
    // 3차시 모둠 글: 주소 끝(1·2 = 대화, t1·t2 = Talk Log)과 영역·글자 수가 맞아야 한다
    function postAreaOk(slot, d) {
      return (slot in ['1', '2'] && d.area in ['sci', 'ux'] && str(d.text, 300))
          || (slot == 't1' && d.area == 'talk1' && str(d.text, 1500))
          || (slot == 't2' && d.area == 'talk2' && str(d.text, 1500));
    }

    // 관리자 명단: 콘솔에서만 만든다. 본인 것과 관리자만 읽을 수 있다.
    match /admins/{mail} {
      allow get: if signedIn() && (mail == em() || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 사용 승인 명단: 관리자가 선생님 이메일을 추가한다.
    match /allowed/{mail} {
      allow get: if signedIn() && (mail == em() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['email', 'school', 'note', 'addedAt', 'addedBy'])
                            && str(request.resource.data.email, 120)
                            && request.resource.data.email.lower() == mail
                            && str(request.resource.data.school, 40)
                            && str(request.resource.data.note, 120);
      allow delete: if isAdmin();
    }

    // 사용 신청: 구글로 로그인한 본인이 자기 이메일로 한 건만 낸다. 관리자가 승인·거절하며 지운다.
    match /requests/{mail} {
      allow get: if signedIn() && (mail == em() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && mail == em()
                            && request.resource.data.keys().hasOnly(['email', 'name', 'school', 'phone', 'createdAt'])
                            && str(request.resource.data.email, 120)
                            && request.resource.data.email.lower() == mail
                            && str(request.resource.data.name, 20) && request.resource.data.name.size() > 0
                            && str(request.resource.data.school, 40) && request.resource.data.school.size() > 0
                            && str(request.resource.data.phone, 20)
                            && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (signedIn() && mail == em());
    }

    match /shelves/{shelfId} {
      // 학생이 코드로 책장을 찾아야 하므로 읽기는 공개. 교사 이메일 같은 개인정보는 넣지 않는다.
      allow read: if true;

      // 책장 만들기는 승인된 선생님만.
      allow create: if isApproved()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['code', 'school', 'teacherName', 'title', 'teacherUid', 'createdAt'])
                    && str(request.resource.data.code, 24)
                    && str(request.resource.data.school, 40)
                    && str(request.resource.data.teacherName, 20)
                    && str(request.resource.data.title, 40)
                    && request.resource.data.createdAt == request.time;

      // 이름 바꾸기·코드 재발급·반 목록 추가. 주인은 바꿀 수 없다(관리자도 마찬가지).
      allow update: if ((request.auth != null && resource.data.teacherUid == request.auth.uid) || isAdmin())
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.keys().hasOnly(['code', 'school', 'teacherName', 'title', 'teacherUid', 'createdAt', 'classes'])
                    && str(request.resource.data.code, 24)
                    && str(request.resource.data.school, 40)
                    && str(request.resource.data.teacherName, 20)
                    && str(request.resource.data.title, 40);

      allow delete: if (request.auth != null && resource.data.teacherUid == request.auth.uid) || isAdmin();

      match /books/{bookId} {
        // 공개 목록은 status == 'approved' 로 걸러 질의해야 통과한다.
        allow read: if resource.data.status == 'approved' || isOwner(shelfId) || isAdmin();

        allow create: if request.resource.data.status == 'pending'
                      && request.resource.data.example == false
                      && codeMatches(shelfId)
                      && request.resource.data.keys().hasOnly(['grade', 'classNo', 'team', 'title', 'url',
                           'intent', 'howto', 'concepts', 'coverKind', 'coverColor', 'coverPath',
                           'status', 'example', 'code', 'createdAt'])
                      && request.resource.data.grade is int
                      && request.resource.data.grade >= 1 && request.resource.data.grade <= 3
                      && request.resource.data.classNo is int
                      && request.resource.data.classNo >= 1 && request.resource.data.classNo <= 20
                      && str(request.resource.data.team, 30)
                      && str(request.resource.data.title, 60)
                      && str(request.resource.data.url, 500)
                      && request.resource.data.url.matches('https://.*')
                      && str(request.resource.data.intent, 600)
                      && str(request.resource.data.howto, 600)
                      && request.resource.data.concepts is list
                      && request.resource.data.concepts.size() <= 8
                      && str(request.resource.data.coverKind, 20)
                      && str(request.resource.data.coverColor, 10)
                      && str(request.resource.data.coverPath, 300)
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if isOwner(shelfId) || isAdmin();
      }

      // 모둠원 학번(필드 이름은 예전 그대로 memberNames): 그 책장을 만든 선생님만. 관리자도 읽지 못한다.
      match /private/{bookId} {
        allow read: if isOwner(shelfId);

        allow create: if codeMatches(shelfId)
                      && request.resource.data.keys().hasOnly(['memberNames', 'code', 'createdAt'])
                      && str(request.resource.data.memberNames, 200)
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if isOwner(shelfId);
      }

      // ----- 활동지 -----
      // 학생은 로그인하지 않는다. 학번 + 비밀번호 4자리로 만든 해시가 자기 문서의 주소다(주소를 아는 사람 = 본인).
      // 목록 보기(list)는 책장 주인 선생님만 한다. 그래서 학생은 남의 주소를 알아낼 수 없다.

      // 학번 자리: 이 학번이 이미 쓰이는지만 알려 준다(이름 없음). 한 번 만들면 학생은 고칠 수 없다.
      match /roster/{sid} {
        allow get: if true;
        allow list: if isOwner(shelfId);
        allow create: if codeMatches(shelfId)
                      && sid.matches('^[1-3][0-9]{4}$')
                      && request.resource.data.keys().hasOnly(['code', 'createdAt'])
                      && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(shelfId);
      }

      // 학생 활동지(개인 칸 백업·모둠 번호)
      match /students/{key} {
        function okStudent(d) {
          return d.keys().hasOnly(['sid', 'name', 'grade', 'classNo', 'num', 'team', 'answers', 'reset', 'from', 'code', 'createdAt', 'updatedAt'])
                 && d.sid is string && d.sid.matches('^[1-3][0-9]{4}$')
                 && (!('name' in d) || str(d.name, 20))   // 이름은 더 받지 않는다. 예전 문서에만 남아 있다가 지워진다
                 && d.grade is int && d.classNo is int && d.num is int
                 && d.team is int && d.team >= 0 && d.team <= 8
                 && d.answers is map && d.answers.size() <= 400
                 && d.reset is bool;
        }
        allow get: if true;
        allow list: if isOwner(shelfId);
        // 새로 만들기는 둘 중 하나일 때만: 처음 온 학생(학번 자리를 같은 묶음에서 처음 만든다)
        // 또는 비밀번호 바꾸기(같은 학번의 옛 문서 from 을 같은 묶음에서 지운다). 그래서 남의 학번으로 문서를 하나 더 만들 수 없다.
        allow create: if isOwner(shelfId)
                      || (codeMatches(shelfId)
                          && okStudent(request.resource.data)
                          && request.resource.data.reset == false
                          && !('name' in request.resource.data)
                          && request.resource.data.createdAt == request.time
                          && ((!exists(/databases/$(database)/documents/shelves/$(shelfId)/roster/$(request.resource.data.sid))
                               && existsAfter(/databases/$(database)/documents/shelves/$(shelfId)/roster/$(request.resource.data.sid)))
                              || (request.resource.data.from is string
                                  && exists(/databases/$(database)/documents/shelves/$(shelfId)/students/$(request.resource.data.from))
                                  && get(/databases/$(database)/documents/shelves/$(shelfId)/students/$(request.resource.data.from)).data.sid == request.resource.data.sid
                                  && !existsAfter(/databases/$(database)/documents/shelves/$(shelfId)/students/$(request.resource.data.from)))));
        // 학생이 고칠 수 있는 것: 개인 칸, 모둠 번호, 비밀번호 새로 정함(reset → false), 예전 이름 지우기. 학번·만든 때는 그대로.
        allow update: if isOwner(shelfId)
                      || (codeMatches(shelfId)
                          && okStudent(request.resource.data)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'team', 'reset', 'code', 'updatedAt', 'name'])
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || !('name' in request.resource.data))
                          && (request.resource.data.reset == false || resource.data.reset == true));
        allow delete: if true;
      }

      // 모둠 칸: 같은 학년·반·모둠 번호의 학생들이 함께 쓴다. 누가 들어왔는지는 선생님이 명단에서 확인한다.
      match /groups/{gid} {
        allow get: if true;
        allow list: if isOwner(shelfId);
        allow create, update: if gid.matches('^[1-3]-[0-9]{1,2}-[1-8]$')
                              && codeMatches(shelfId)
                              && request.resource.data.keys().hasOnly(['answers', 'code', 'updatedAt'])
                              && request.resource.data.answers is map
                              && request.resource.data.answers.size() <= 80;
        allow delete: if isOwner(shelfId);

        // 3차시 모둠 대화: 글 주소가 {학번}-1, {학번}-2 뿐이라 한 학생은 3차시 전체에서 글을 2개까지만 올린다.
        // 학번의 학년·반이 모둠 문서(학년-반-모둠)와 같아야 한다. 고치기·지우기 단추는 화면에서 내 글에만 보인다.
        // Talk Log 추가 프롬프트는 {학번}-t1(수정)·{학번}-t2(고도화)에 한 사람 하나씩 올린다 (대화 2개와 따로 센다).
        match /posts/{pid} {
          allow read: if true;
          allow create, update: if pid.matches('^[1-3][0-9]{4}-([12]|t[12])$')
                                && codeMatches(shelfId)
                                && request.resource.data.keys().hasOnly(['sid', 'area', 'text', 'code', 'createdAt', 'updatedAt'])
                                && request.resource.data.sid == pid.split('-')[0]
                                && gid.split('-')[0] == pid[0:1]
                                && int(gid.split('-')[1]) == int(pid[1:3])
                                && postAreaOk(pid.split('-')[1], request.resource.data)
                                && request.resource.data.text.size() > 0;
          allow delete: if true;
        }
      }
    }
  }
}
