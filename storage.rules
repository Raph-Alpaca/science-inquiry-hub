rules_version = '2';

// 표지 캡처 이미지
//  - 읽기: 공개(책장에 그대로 보여야 하므로)
//  - 올리기: 비로그인 학생도 가능하지만 2 MB 이하 이미지만
//  - 덮어쓰기·지우기: 로그인한 선생님만
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{shelfId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
      allow update, delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
